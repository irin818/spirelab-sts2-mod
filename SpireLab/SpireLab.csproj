<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <Publicize>False</Publicize> <!--Allows access to originally private/protected members but may (unlikely to) cause errors.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Disable architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
        <ModOutputDir Condition="'$(ModOutputDir)' == ''">$(MSBuildProjectDirectory)/bin/mods/$(Configuration)/$(AssemblyName)</ModOutputDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(WitchTestLab)' == 'true'">
        <DefineConstants>$(DefineConstants);SPIRELAB_TEST_LAB</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'ExportRelease'">
        <AssemblyMetadata Include="SpireLab.PackageKind" Value="WorkshopRelease" />
    </ItemGroup>

    <Target Name="CheckTestLabConfiguration" BeforeTargets="PrepareForBuild">
        <Error Condition="'$(WitchTestLab)' == 'true' and '$(Configuration)' != 'Debug'"
               Text="Witch Test Lab requires a separate Debug build." />
    </Target>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')" >
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <!-- The editor reflects over the Debug assembly. StageModAssembly only copies Mod files. -->
            <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
            <Private Condition="'$(Configuration)' != 'Debug'">false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="$(Publicize)">
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.4.8" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.2.1" PrivateAssets="All" />
        <!-- Generates a .pck file when building if only using simple assets. May not work on all setups. Uncomment to test. -->
        <!-- <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="All" /> -->
        <AdditionalFiles Include="SpireLab/localization/**/*.json"/> <!-- Used by analyzer -->
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="SpireLab/**" />
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <EmbeddedResource Remove="SpireLab/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore" />
        <None Include="SpireLab.json" />
        <None Include="project.godot"/>
        <None Include="SpireLab/**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="SpireLab\images\card_portraits\big\" />
      <Folder Include="SpireLab\images\powers\big\" />
      <Folder Include="SpireLab\images\relics\big\" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths" >
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)/sts2.dll')" />
    </Target>

    <Target Name="StageModAssembly" AfterTargets="Build" Condition="'$(IsInnerGodotExport)' != 'true'">
        <Copy SourceFiles="$(TargetPath);$(AssemblyName).json;$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModOutputDir)" />
    </Target>

    <Target Name="NeedGodotForPublish" BeforeTargets="Publish" Condition="'$(IsInnerGodotExport)' != 'true'">
        <Error Text=" Godot path must be set up before publishing; Godot not found at path '$(GodotPath)'. Check Directory.Build.props file."
               Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')"/>
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot resource pack to $(ModOutputDir)" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModOutputDir)/$(AssemblyName).pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              WorkingDirectory="$(MSBuildProjectDirectory)"/>
    </Target>
</Project>
